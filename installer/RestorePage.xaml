<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,34,40,28" MaxWidth="780">
            <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" Text="Restore"/>
            <TextBlock x:Name="PageSubtitle" Style="{StaticResource Text.Subtitle}" Text="Gives the screen back its Samsung behaviour, in case of trouble or before you stop using APL Launcher."/>

            <!-- ================= FORM ================= -->
            <StackPanel x:Name="FormView" Margin="0,26,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H2}" Text="What Restore does" Margin="0,0,0,8"/>
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Accent}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE80F;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Home goes back to Samsung"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="The Home button opens Samsung's menu again."/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Separator}" Margin="44,0,0,0"/>
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Gray}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE765;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Key interception is turned off"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="Vetro stops catching the remote's buttons."/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Separator}" Margin="44,0,0,0"/>
                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Orange}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7A7;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="The optimization is undone"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="From its backup: Samsung components, ad filter and switches come back. Uninstalled apps can be reinstalled from the App Store."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Also uninstall APL Launcher"/>
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="Removes the launcher from the screen. Leave it off to keep it, ready to come back."/>
                        </StackPanel>
                        <CheckBox x:Name="UninstallToggle" Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="False"/>
                    </Grid>
                </Border>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Hint" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="2,0,20,0"/>
                    <Button x:Name="RestoreButton" Grid.Column="1" Style="{StaticResource Button.Large}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE777;" FontSize="14" Margin="0,1,10,0"/>
                            <TextBlock Text="Restore"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ================= RUNNING / RESULT ================= -->
            <StackPanel x:Name="RunView" Visibility="Collapsed" Margin="0,26,0,0">
                <Border Style="{StaticResource Card}" Padding="22,20,22,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="OverallText" Style="{StaticResource Text.Secondary}"/>
                        </Grid>
                        <ProgressBar x:Name="OverallBar"/>
                        <StackPanel x:Name="Steps" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="DoneCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="DoneMark" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.H2}" FontSize="20" Text="The screen is back as before"/>
                                <TextBlock x:Name="DoneText" Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Separator}" Margin="0,16,0,14"/>
                        <TextBlock x:Name="ReminderPath" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text2}" Margin="0,0,0,12"/>
                        <Border CornerRadius="12" Background="{StaticResource Brush.Input}" Padding="16,0">
                            <StackPanel>
                                <Grid Height="44">
                                    <TextBlock x:Name="SmartHubName" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,150,0"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="7" Background="#1E5631" Padding="10,3,10,4">
                                        <TextBlock Text="On" FontSize="13" FontWeight="SemiBold" Foreground="#5BE07F"/>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Separator}" Background="#34353B"/>
                                <Grid Height="44">
                                    <TextBlock x:Name="LastAppName" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,150,0"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="7" Background="#3A3A3F" Padding="10,3,10,4">
                                        <TextBlock Text="As you like" FontSize="13" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="FailCard" Style="{StaticResource Card}" Background="{StaticResource Brush.RedTint}" BorderBrush="{StaticResource Brush.RedTintBorder}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="FailMark" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource Text.Label}" FontSize="15" Text="Restore stopped"/>
                            <TextBlock x:Name="FailText" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text2}" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="RetryButton" Style="{StaticResource Button.Primary}" Content="Try again" Margin="0,0,10,0"/>
                                <Button x:Name="BackButton" Style="{StaticResource Button.Secondary}" Content="Back"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander x:Name="Details" Header="Details" Margin="2,0,0,0">
                    <TextBox x:Name="LogBox" Style="{StaticResource LogBox}"/>
                </Expander>
                <Button x:Name="DoneBack" Style="{StaticResource Button.Plain}" HorizontalAlignment="Left" Margin="-10,10,0,0" Content="Back" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Grid>
