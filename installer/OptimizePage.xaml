<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,34,40,28" MaxWidth="780">
            <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" Text="Optimize"/>
            <TextBlock x:Name="PageSubtitle" Style="{StaticResource Text.Subtitle}" Text="Removes what the screen doesn't need, so it starts faster and stays quiet. Nothing is deleted from the system, and Restore undoes it."/>

            <!-- No screen yet -->
            <Border x:Name="NoScreenCard" Style="{StaticResource Card}" Margin="0,26,0,16" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Gray}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F4;" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Label}" FontSize="15" Text="No screen yet"/>
                        <TextBlock x:Name="NoScreenText" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="GoInstall" Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="Choose the screen" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Read the screen -->
            <Border x:Name="ReadCard" Style="{StaticResource Card}" Margin="0,26,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Orange}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ReadTitle" Style="{StaticResource Text.Label}" FontSize="15" Text="Read the screen"/>
                            <TextBlock x:Name="ReadText" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="Lists what is installed and what can go. About 30 seconds; nothing is changed."/>
                        </StackPanel>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="ReadButton" Style="{StaticResource Button.Primary}" Content="Read the screen"/>
                            <Control x:Name="ReadSpinner" Template="{StaticResource Spinner}" Width="22" Height="22" Foreground="{StaticResource Brush.Text2}" Visibility="Collapsed" Focusable="False"/>
                        </Grid>
                    </Grid>
                    <Expander x:Name="ReadDetails" Header="Details" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBox x:Name="ReadLog" Style="{StaticResource LogBox}" Height="180"/>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ================= PLAN ================= -->
            <StackPanel x:Name="PlanView" Visibility="Collapsed" Margin="0,26,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Red}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74D;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.H2}" Text="Uninstall downloaded apps"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="Untick the ones you use. They can be reinstalled from the App Store."/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="AppsList" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Indigo}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7E8;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.H2}" Text="Turn off Samsung components"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="They no longer start by themselves. Nothing is erased, and the system parts the screen needs are never touched."/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="AreasList"/>
                    </StackPanel>
                </Border>

                <Border x:Name="YouTubeCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Red}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE768;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.H2}" Text="Samsung's YouTube"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="TizenTube replaces it. It can be reinstalled from the App Store."/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="YouTubeCheck" IsChecked="False" Margin="5,10,0,4" Content="Uninstall Samsung's YouTube"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Teal}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.H2}" Text="Also"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="AlsoList"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22,14">
                    <Expander x:Name="KeptExpander">
                        <Expander.Header>
                            <TextBlock x:Name="KeptHeader" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Text="Kept"/>
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,4">
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" Text="Never touched: Vetro, TizenBrew and TizenTube, the App Store and the Samsung account, HDMI sources, Samsung TV Plus, AirPlay, Bluetooth, and everything the system needs."/>
                            <WrapPanel x:Name="KeptList"/>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>

            <!-- ================= RUNNING / RESULT ================= -->
            <StackPanel x:Name="RunView" Visibility="Collapsed" Margin="0,26,0,0">
                <Border x:Name="RunCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Control x:Name="RunSpinner" Template="{StaticResource Spinner}" Width="20" Height="20" Foreground="{StaticResource Brush.Text2}" Focusable="False" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RunText" Grid.Column="1" Style="{StaticResource Text.Body}" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <TextBlock x:Name="RunPercent" Grid.Column="2" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar x:Name="RunBar"/>
                    </StackPanel>
                </Border>

                <Border x:Name="DoneCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="DoneMark" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.H2}" FontSize="20" Text="The screen is optimized"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,3,0,0" Text="Restore undoes it whenever you want."/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Separator}" Margin="0,0,0,12"/>
                        <StackPanel x:Name="SummaryList"/>
                    </StackPanel>
                </Border>

                <Border x:Name="FailCard" Style="{StaticResource Card}" Background="{StaticResource Brush.RedTint}" BorderBrush="{StaticResource Brush.RedTintBorder}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="FailMark" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource Text.Label}" FontSize="15" Text="The optimization stopped"/>
                            <TextBlock x:Name="FailText" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text2}" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="RetryButton" Style="{StaticResource Button.Primary}" Content="Try again" Margin="0,0,10,0"/>
                                <Button x:Name="BackButton" Style="{StaticResource Button.Secondary}" Content="Back to the list"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander x:Name="Details" Header="Details" Margin="2,0,0,0">
                    <TextBox x:Name="LogBox" Style="{StaticResource LogBox}"/>
                </Expander>
                <Button x:Name="AgainButton" Style="{StaticResource Button.Plain}" HorizontalAlignment="Left" Margin="-10,10,0,0" Content="Read the screen again" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- ================= FOOTER (plan only) ================= -->
    <Border x:Name="Footer" Grid.Row="1" Background="#15161A" BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,1,0,0" Visibility="Collapsed">
        <Grid Margin="40,14,40,14" MaxWidth="780">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterHint" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button x:Name="ReadAgain" Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Read again" Height="40" Margin="0,0,10,0"/>
            <Button x:Name="OptimizeButton" Grid.Column="2" Style="{StaticResource Button.Large}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE945;" FontSize="14" Margin="0,1,10,0"/>
                    <TextBlock Text="Optimize"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Grid>
